# Set these as environment variables in your hosting provider. Never put secrets in Android code or Git.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match the callback URL registered in Meta Developer settings:
INSTAGRAM_REDIRECT_URI=https://YOUR-BACKEND-DOMAIN/auth/instagram/callback
# Optional; defaults to the app deep link below
APP_REDIRECT_URI=instatracker://oauth
PORT=3000
